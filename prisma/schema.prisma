// Prisma schema for SeftonCoastWildlife - analytics only

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PageView {
  id        String   @id @default(uuid())
  path      String
  referrer  String?
  device    String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

// Daily page counts: the page, the day and a number. Nothing about the visitor.
// Created by prisma/sql/2026-11-page-count.sql (applied with `prisma db execute`, never `db push`).
model PageCount {
  path  String
  day   DateTime @db.Date
  count Int      @default(0)

  @@id([path, day])
}
